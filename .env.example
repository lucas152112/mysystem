# Database Configuration
DATABASE_URL=mysql://username:password@localhost:3306/mysystem
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=mysystem
MYSQL_USER=mysystem_user
MYSQL_PASSWORD=mysystem_password

# Backend Configuration
RUST_LOG=info
RUST_BACKTRACE=1
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# Frontend Configuration
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NUXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3000/api/ws
NODE_ENV=production

# Security Configuration
ALLOWED_COMMANDS=ls,cat,pwd,echo,systemctl,service,nginx,mysql,docker,docker-compose
MAX_EXECUTION_TIME=30
MAX_CONCURRENT_EXECUTIONS=10
COMMAND_TIMEOUT_SECONDS=30

# WebSocket Configuration
WEBSOCKET_PORT=3000
WEBSOCKET_HOST=0.0.0.0

# Logging Configuration
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
LOG_FILE_PATH=./logs

# Notification Configuration
EMAIL_NOTIFICATIONS=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@mysystem.local

# Webhook Configuration
WEBHOOK_URL=
WEBHOOK_SECRET=

# SSL Configuration (for production)
SSL_CERT_PATH=./ssl/server.crt
SSL_KEY_PATH=./ssl/server.key
SSL_ENABLED=false

# Docker Configuration
DOCKER_NETWORK=mysystem-network
DOCKER_REGISTRY=
DOCKER_IMAGE_PREFIX=mysystem

# Development vs Production
NODE_ENV=development
DEBUG=false

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# JWT Configuration (for future authentication)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization

# Feature Flags
FEATURE_HOT_RELOAD=false
FEATURE_AUTO_UPDATE=false
FEATURE_REMOTE_EXECUTION=false
FEATURE_CLUSTER_MODE=false